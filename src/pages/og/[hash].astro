---
import pages from '../../generated/pages.json';
export function getStaticPaths() {
  return pages.map(page => ({ params: { hash: page.og.hash }, props: { card: page.og } }));
}
const { card } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>{card.title}</title></head>
<body data-pagefind-ignore><main id="og-card">
  <div class="brand"><span>&lt;/&gt;</span> HTML/CSS to Image <small>DOCUMENTATION</small></div>
  <div class="content"><p class="section">{card.section}</p><h1>{card.title}</h1><p class="description">{card.description}</p></div>
  <footer><span>docs.htmlcsstoimage.com</span><span class="arrow">↗</span></footer>
</main></body></html>
<style>
  *{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif}#og-card{width:1200px;height:630px;background:#f7f9f6;color:#171b22;padding:52px 66px;display:flex;flex-direction:column;border-top:10px solid #02b875;position:relative;overflow:hidden}
  #og-card:after{content:'';position:absolute;width:340px;height:340px;border:65px solid #02b87512;border-radius:50%;right:-160px;bottom:-190px}
  .brand{display:flex;align-items:center;gap:14px;font-weight:700;font-size:25px;letter-spacing:-.8px}.brand>span{background:#02b875;border-radius:12px;padding:9px;color:#102a20;font-family:monospace}.brand small{margin-left:auto;font-size:13px;letter-spacing:2px;color:#52655b}
  .content{margin:auto 0}.section{font-size:17px;text-transform:uppercase;letter-spacing:2px;color:#007a4e;font-weight:700;margin:0 0 18px}h1{font-size:58px;line-height:1.08;letter-spacing:-2px;margin:0;max-width:1060px;text-wrap:balance}.description{font-size:23px;line-height:1.45;color:#53605b;max-width:950px;margin:20px 0 0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}footer{display:flex;align-items:center;justify-content:space-between;color:#52655b;font-size:19px}.arrow{font-size:34px;color:#007a4e}
</style>
