---
interface Props {
  id: string;
  title: string;
  description: string;
  href: string;
}
const { id, title, description, href } = Astro.props;
---
<article class="example-card flex min-w-0 flex-col gap-3 rounded-lg border border-solid border-[var(--sl-color-hairline)] p-5" id={id}>
  <h3 class="m-0 text-[1.15rem] leading-[1.35]"><a class="text-[var(--sl-color-white)] no-underline hover:text-[var(--sl-color-text-accent)]" href={href}>{title}<span class="text-[var(--sl-color-text-accent)]" aria-hidden="true"> →</span></a></h3>
  <p class="m-0 text-[.9rem] leading-[1.6]">{description}</p>
  <div class="example mt-auto min-w-0 pt-1 [&_.copy]:hidden!"><slot /></div>
</article>
<style>
  /* Expressive Code is rendered by the Markdown pipeline inside the slot. */
  .example :global(.expressive-code) { margin:0; --ec-codeFontSize:.75rem; --ec-codePaddingBlock:.85rem; --ec-codePaddingInline:1rem; }
</style>
