---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import PageActions from './PageActions.astro';
import Breadcrumbs from './Breadcrumbs.astro';
const { entry } = Astro.locals.starlightRoute;
const pageTitle = entry.data.page_title ?? entry.data.title;
const route = Astro.url.pathname;
const markdownPath = route === '/' ? '/index.md' : `${route.replace(/\/$/, '')}.md`;
---
<Breadcrumbs />
<div class="page-heading">
  {entry.data.page_title ? <h1 id="_top">{pageTitle}</h1> : <DefaultPageTitle />}
  {entry.id !== '404' && <PageActions markdownPath={markdownPath} title={pageTitle} />}
</div>
{entry.data.changelog && <p class="published"><time data-changelog-date datetime={entry.data.changelog.date}>{new Date(`${entry.data.changelog.date}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time></p>}
<style>
  h1 { margin-top:1rem; font-size:var(--sl-text-h1); line-height:var(--sl-line-height-headings); font-weight:600; color:var(--sl-color-white); }
  .published { margin:.8rem 0 0; font-size:.9rem; color:var(--sl-color-gray-3); }
  .page-heading { display:flex; align-items:center; gap:1rem; justify-content:space-between; margin-top:.5rem; }
  .page-heading :global(h1) { min-width:0; margin-top:0; }
  @media(max-width:40rem) { .page-heading { flex-wrap:wrap; } }
</style>
