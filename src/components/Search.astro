---
import '../styles/search.css';
const shortcuts = [
  ['Getting started', 'Make your first API request', '/getting-started/'],
  ['API keys', 'Authentication and permissions', '/getting-started/using-the-api/api-keys/'],
  ['Parameters', 'Control how your images render', '/parameters/'],
  ['Template Editor', 'Build reusable image templates', '/template-editor/'],
  ['MCP setup', 'Connect your AI assistant', '/integrations/mcp/'],
];
---
<div class="docs-search" data-pagefind-ignore>
  <button class="pf-trigger-btn flex items-center gap-2 px-3 text-sm" type="button" data-search-trigger aria-label="Search docs" aria-haspopup="dialog" aria-expanded="false" aria-keyshortcuts="Control+k Meta+k">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
    <span class="pf-trigger-text">Search docs</span>
    <span class="pf-trigger-shortcut ml-auto" aria-hidden="true"><kbd class="pf-trigger-key" data-search-shortcut>⌘</kbd><kbd class="pf-trigger-key">K</kbd></span>
  </button>
  <dialog class="pf-modal search-loading" aria-label="Search docs" data-search-loading>
    <div class="flex items-center gap-3 p-4">
      <input class="min-w-0 flex-1 rounded border border-solid border-[var(--pf-border)] bg-transparent p-3 text-[var(--pf-text)] outline-[var(--pf-border-focus)]" type="search" aria-label="Search docs" placeholder="Search docs, parameters, and guides…" autofocus />
      <button class="cursor-pointer rounded px-2 py-1 text-sm" type="button" data-search-cancel aria-label="Close search">Esc</button>
    </div>
    <p class="px-4 pb-4 text-sm" role="status" data-search-status>Loading search…</p>
    <button class="m-4 cursor-pointer underline" type="button" data-search-retry hidden>Retry</button>
  </dialog>
  <template data-search-template>
  <pagefind-config bundle-path="/search/" base-url="/" excerpt-length="18" preload></pagefind-config>
  <pagefind-modal>
    <pagefind-modal-header>
      <pagefind-input placeholder="Search docs, parameters, and guides…" debounce="100"></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
      <div class="search-start">
        <p class="search-eyebrow">Quick links</p>
        <nav aria-label="Search quick links">
          {shortcuts.map(([title, description, href]) => <a href={href}><span><strong>{title}</strong><small>{description}</small></span><span aria-hidden="true">→</span></a>)}
        </nav>
        <p class="search-tip">Try a parameter like <code>viewport</code> or a task like <code>create PDF</code>.</p>
      </div>
      <pagefind-summary></pagefind-summary>
      <div class="search-no-results" hidden>
        <p>Try a shorter phrase, a parameter name, or a different spelling.</p>
        <a href="/parameters/">Browse parameters</a><span aria-hidden="true"> · </span><a href="/guides/">Explore guides</a>
      </div>
      <pagefind-results max-sub-results="2" max-results="20"></pagefind-results>
    </pagefind-modal-body>
    <pagefind-modal-footer>
      <span class="search-key-help"><kbd>↑</kbd><kbd>↓</kbd> navigate <kbd>↵</kbd> open <kbd>esc</kbd> close</span>
      <span class="search-footer-label">HCTI Docs</span>
    </pagefind-modal-footer>
  </pagefind-modal>
  </template>
</div>
<script>
  import { initializeLazySearch } from '../scripts/search-loader';
  initializeLazySearch();
</script>
