---
import DefaultTwoColumnContent from '@astrojs/starlight/components/TwoColumnContent.astro';
---
<div class="docs-columns">
  <DefaultTwoColumnContent>
    <slot name="right-sidebar" slot="right-sidebar" />
    <slot />
  </DefaultTwoColumnContent>
</div>
<style>
  .docs-columns :global(.content-panel) { min-width:0; }
  /* Share the title/content rows so wrapped titles also align the TOC. */
  @media (min-width:72rem) {
    .docs-columns :global(.lg\:sl-flex:has(.right-sidebar-container)) {
      display:grid;
      grid-template-columns:minmax(0, 1fr) max(var(--sl-sidebar-width), calc(var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2));
      grid-template-rows:auto 1fr;
    }
    .docs-columns :global(.right-sidebar-container) { grid-column:2; grid-row:2; width:auto; border-top:1px solid var(--sl-color-hairline); }
    .docs-columns :global(.right-sidebar-container + .main-pane) { display:contents; }
    .docs-columns :global(.right-sidebar-container + .main-pane > main) {
      grid-column:1;
      grid-row:1 / span 2;
      display:grid;
      grid-template-rows:subgrid;
      grid-template-columns:minmax(0, 1fr);
      min-width:0;
    }
  }
</style>
