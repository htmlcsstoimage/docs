---
import pages from '../generated/pages.json';
import { structuredData, serializeStructuredData } from '../lib/structured-data.mjs';
const page = pages.find(page => page.route === Astro.url.pathname);
const { head, entry } = Astro.locals.starlightRoute;
const jsonLd = page && structuredData({
  origin: Astro.site?.href ?? Astro.url.origin,
  route: page.route,
  title: entry.data.page_title ?? entry.data.title,
  description: entry.data.description,
  image: page.og.image,
  datePublished: entry.data.changelog?.date,
  overview: page.route === '/' || page.route === '/changelog/' || /\/index\.mdx?$/.test(page.file),
});
const siteTitle = 'HTML/CSS to Image API Docs';
const brandedTitle = (title: string) => title === siteTitle || title.endsWith(` | ${siteTitle}`)
  ? title : `${title} | ${siteTitle}`;
const tags = head.filter(tag => tag.tag !== 'title' &&
  !(tag.tag === 'meta' && tag.attrs?.name === 'generator'))
  .map(tag => tag.tag === 'meta' &&
    (tag.attrs?.property === 'og:title' || tag.attrs?.name === 'twitter:title')
    ? { ...tag, attrs: { ...tag.attrs, content: brandedTitle(entry.data.og_title ?? entry.data.title) } }
    : tag);
---
<title>{brandedTitle(entry.data.title)}</title>
{jsonLd && <script type="application/ld+json" set:html={serializeStructuredData(jsonLd)} />}
{entry.data.changelog && <meta property="article:published_time" content={entry.data.changelog.date} />}
<meta data-pagefind-filter="kind[content]" content={entry.data.changelog ? 'changelog' : 'docs'} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap" />
{tags.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
{!tags.some(tag => tag.tag === 'meta' && tag.attrs?.name === 'twitter:title') &&
  <meta name="twitter:title" content={brandedTitle(entry.data.og_title ?? entry.data.title)} />}
{page && <link rel="alternate" type="text/markdown" href={page.markdownPath} />}
{page?.og.image && <>
  <meta property="og:image" content={page.og.image} />
  <meta name="twitter:image" content={page.og.image} />
  <meta property="og:image:alt" content={page.og.title} />
  <meta name="twitter:image:alt" content={page.og.title} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
</>}
