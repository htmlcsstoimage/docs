---
import SiteTitle from './SiteTitle.astro';
import Search from './Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
---
<div class="docs-header">
  <SiteTitle />
  <div class="header-search"><Search /></div>
  <nav aria-label="Website" class="website-nav">
    <a href="https://htmlcsstoimage.com/">Home</a>
    <a href="https://htmlcsstoimage.com/pricing">Pricing</a>
    <a class="get-started" href="https://htmlcsstoimage.com/dashboard">Get Started</a>
  </nav>
  <div class="theme-picker" title="Choose color theme"><ThemeSelect /></div>
</div>
<style>
  .docs-header { display:grid; grid-template-columns:1fr minmax(12rem,26rem) 1fr auto; gap:1.5rem; align-items:center; height:100%; color:#fff; }
  .header-search { min-width:0; }
  .website-nav { display:flex; align-items:center; justify-content:flex-end; gap:1.5rem; white-space:nowrap; font-size:.875rem; }
  a { color:#e5e7eb; text-decoration:none; } a:hover { color:#42d99c; }
  .get-started { text-decoration:underline; text-decoration-color:#02b875; text-decoration-thickness:2px; text-underline-offset:.45rem; }
  .theme-picker :global(label) { width:2.25rem; height:2.5rem; color:#d1d5db; border-radius:.35rem; }
  .theme-picker :global(label:hover) { background:#ffffff10; color:#fff; }
  .theme-picker :global(label:focus-within) { outline:2px solid #42d99c; outline-offset:2px; }
  .theme-picker :global(select) { width:100%; height:100%; margin:0; padding:0; color:transparent; text-indent:3rem; text-overflow:clip; outline:none; }
  .theme-picker :global(.label-icon) { inset-inline-start:50%; transform:translate(-50%,-50%); font-size:1rem; }
  .theme-picker :global(.caret) { display:none; }
  .theme-picker :global(option) { background:#212529; color:#fff; text-indent:0; }
  .header-search :global(button[data-open-modal]) { width:100%; background:#ffffff0a; color:#d1d5db; border-color:#ffffff35; border-radius:.35rem; }
  @media(max-width:65rem) { .docs-header { gap:1rem; grid-template-columns:auto 1fr auto auto; } .website-nav { gap:.8rem; } }
  @media(max-width:49.99rem) { .docs-header { grid-template-columns:auto 1fr auto; gap:.5rem; } .website-nav { display:none; } .header-search { justify-self:end; } .theme-picker { font-size:.85rem; } }
</style>
