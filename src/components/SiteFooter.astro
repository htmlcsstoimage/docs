---
const main = 'https://htmlcsstoimage.com';
const groups = [
  {title:'Information', links:[['Documentation','/'],['API Reference',main+'/api-docs/'],['Pricing',main+'/pricing'],['Status','https://status.htmlcsstoimage.com'],['Blog',main+'/blog'],['Twitter','https://twitter.com/htmlcsstoimage'],['GitHub','https://github.com/htmlcsstoimage/docs'],['Changelog','/changelog/'],['llms.txt','/llms.txt']]},
  {title:'Integration', links:[['Zapier','/integrations/zapier/'],['Make','/integrations/make/'],['GitHub Actions','https://github.com/marketplace/actions/html-css-to-image'],['AI/MCP','/integrations/mcp/'],['API Guides','/guides/']]},
  {title:'Examples', links:[['Sample Code','/example-code/'],['Example Images',main+'/examples'],['Template Presets',main+'/templates'],['Recent Templates',main+'/templates/recent'],['Templates Demo',main+'/templates/playground']]},
  {title:'Company', links:[['About',main+'/about'],['Contact us',main+'/contact'],['LinkedIn','https://www.linkedin.com/company/html-css-to-image']]},
  {title:'Tools', links:[['Social Card Preview',main+'/tools/social-card-previewer'],['URL Screenshot Tester',main+'/features/url-screenshots#try-the-url-screenshot-api']]},
  {title:'Legal', links:[['Terms of Use',main+'/terms'],['Privacy Policy',main+'/privacy']]},
];
---
<footer class="site-footer" aria-label="HTML/CSS to Image" data-pagefind-ignore>
  <div class="footer-links">
    {groups.map(group => <section><h2>{group.title}</h2><ul>{group.links.map(([label,href]) => <li><a href={href}>{label}</a></li>)}</ul></section>)}
  </div>
  <div class="footer-bottom">
    <a href={main} aria-label="HTML/CSS to Image home"><img src="/assets/images/hcti-logo.svg" alt="HTML/CSS to Image" width="50" height="50" /></a>
    <div><p>© 2018 – {new Date().getFullYear()} Code Happy, LLC</p><p>Made with an extensive amount of integration tests and serious care for developer happiness.</p></div>
    <a class="support" href="mailto:support@htmlcsstoimage.com">support@htmlcsstoimage.com</a>
  </div>
</footer>
<style>
  .site-footer { position:relative; background:#212529; color:#d1d5db; padding:3rem clamp(1.5rem,4vw,4rem) 2rem; margin-top:4rem; font-size:.85rem; }
  .footer-links { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:2rem; max-width:80rem; margin:auto; }
  h2 { font-size:1rem; font-weight:550; margin:0 0 .8rem; color:#fff; }
  ul { list-style:none; margin:0; padding:0; } li + li { margin-top:.4rem; }
  a { color:inherit; text-decoration:none; } a:hover { color:#42d99c; text-decoration:underline; }
  .footer-bottom { border-top:1px solid #ffffff25; margin:2.5rem auto 0; padding-top:1.5rem; display:flex; flex-wrap:wrap; align-items:center; gap:1rem; max-width:80rem; font-size:.75rem; }
  .footer-bottom p { margin:0; } .footer-bottom p + p { margin-top:.35rem; max-width:32rem; color:#9ca3af; }
  .support { overflow-wrap:anywhere; }
  @media(min-width:90rem) { .footer-links { grid-template-columns:repeat(6,minmax(0,1fr)); } }
  @media(max-width:40rem) { .footer-links { grid-template-columns:repeat(2,minmax(0,1fr)); } }
</style>
